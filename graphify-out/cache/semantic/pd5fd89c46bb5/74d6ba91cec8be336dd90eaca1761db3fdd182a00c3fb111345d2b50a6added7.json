gress_pi_s0_final", "label": "Final pi_S0 (from scratch, model_12200)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L279", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrained from scratch because gates alone missed feet-under-hips, tibia-fold lift, and leg overlap; coordinated lift chosen by user."}, {"id": "research_progress_from_scratch_control_arm", "label": "From-scratch control arm (spec 4.2)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passed all S0b gates at 0.30x the warm-start budget and turned symmetrically, so warm start and KL anchor were dropped for every arm."}, {"id": "research_progress_s1_blind_trunk", "label": "S1 blind trunk (Hexapod-S1-v0)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L326", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_s1_pilot3", "label": "S1 pilot 3 (seed 42, W 50, model_7999)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L413", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted 2026-09-27 as the S1 configuration: per-leg touchdown_reach and 4 cm cpg_z_target fixed pilot-1 leg overlap and lift drift."}, {"id": "research_progress_s1_five_seeds", "label": "S1 trunks seeds 42-46 (pairing units)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L457", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five trunks reproduce the result with small spread; they are the pairing units for spec 10.1 paired statistics (D31: 5 not 8)."}, {"id": "research_progress_w_sweep", "label": "TCN window W sweep (W=50 kept)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L451", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V slip error prefers short windows, probes prefer long; W 75 dominated, W 25 trades V for touchdown timing; W 50 kept (D32)."}, {"id": "research_progress_spatial_terrain_materials", "label": "Spatial terrain material field (Voronoi, 10-entry library)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L331", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contract P material strips, touchdown-material probes and V's slip test need spatially varying materials; static field so every arm/seed sees one layout (D27)."}, {"id": "research_progress_ax12a_servo_model", "label": "AX-12A servo model (hexasim/actuators/ax12a.py)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_dropped_reads_pipeline", "label": "Dropped reads, ZOH and 18-bit validity mask (mdp/proprio.py)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drop probability tied to servo load instead of tracking error, since an infeasible target grows tracking error unboundedly (D8)."}, {"id": "research_progress_physx_external_forces_every_iteration", "label": "PhysX enable_external_forces_every_iteration fix (D11)", "file_type": "rationale", "source_file": "research_progress.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With default TGS False, explicit joint efforts barely act; replaying pi_base actions isolated the solver as the cause."}, {"id": "research_progress_static_torque_envelope", "label": "Static torque envelope and rest pose femur/tibia +30 deg", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 pose needs 134% of AX-12A stall at femur; +30/+30 pose needs 12%. Isaac Lab applied_torque under-reads ~2x, so lever-arm torques are used."}, {"id": "research_progress_toe_pos_w", "label": "Toe point toe_pos_w (replaces 0.0892 m constant)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_friction_multiply_ground_mu_075", "label": "Friction combine multiply, ground mu 0.75 (D7)", "file_type": "rationale", "source_file": "research_progress.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Robot USD had no collider material, so pi_base trained at effective mu 0.75; matching it reduced falls from 40% to 9%."}, {"id": "research_progress_reward_economy_check", "label": "Reward economy check (walk > stand > fall, reward_economy.py)", "file_type": "rationale", "source_file": "research_progress.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_touchdown_reach", "label": "touchdown_reach term (per-leg two-sided)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-sided form holds back the reach-weighted coxa stroke; one-sided form caused sprawl; single rest target pulled front legs inward and closed leg gaps."}, {"id": "research_progress_leg_proximity_penalty", "label": "leg_proximity_penalty (capsule gap, -400 then -1600)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-collision is off in sim so legs passed through each other; per-joint coxa limits rejected because collisions depend on angle pairs."}, {"id": "research_progress_swing_radial_motion", "label": "swing_radial_motion term (coordinated lift)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L267", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_rest_reach_bug", "label": "coxa_rest_reach measured in USD zero pose bug", "file_type": "rationale", "source_file": "research_progress.md", "source_location": "L259", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured before rest pose applied, so coxa stroke term ran at ~0.32x strength; lesson: measure at the right time."}, {"id": "research_progress_velocity_estimator_v", "label": "Velocity estimator V = v_kin + delta v_hat", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces privileged-trained V_0; ~2.5x more accurate; must pass v7 4.3 slip-stratified and IMU-dropout tests before e_hat gate opens."}, {"id": "research_progress_v0_estimator", "label": "V_0 (5-frame o_p MLP velocity estimate, D2)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_v0_to_v_switch", "label": "V_0 -> V switch via gated e_hat and per-episode dropout (D23)", "file_type": "rationale", "source_file": "research_progress.md", "source_location": "L360", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function-preserving: e_hat columns zero-init behind binary gate; V_0 dropped per episode, never per step."}, {"id": "research_progress_e_p_tcn", "label": "E_p causal dilated TCN (rl/s1/tcn.py, RF 61 >= W)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L353", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_universal_probes", "label": "Universal probes with beta-NLL (beta 0.5)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_contract_p", "label": "Contract P (683-D critic privileged input)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L352", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_actor_layout_1125", "label": "1,125-D union actor layout (mdp/layout.py)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L352", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_s1ppo", "label": "S1PPO (rl/s1_ppo.py)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L358", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_mirror_augmentation", "label": "Left-right mirror augmentation (mdp/symmetry.py, D21)", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "research_progress_standing_mode", "label": "Standing mode at zero command (D13) and settle window", "file_type": "concept", "source_file": "research_progress.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen clock in observation kept policy in swing mode, so clock is zeroed when standing; settle window fixed standing because every hold penalty made st